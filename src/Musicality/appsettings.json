{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "Title": "Musicality API",
    "Description": "HTTP API for Musicality.",
    "ContactUrl": ""
  },
  "CoreOptions": {
    "MessagePersistanceInDays": 3,
    "AllowedUpdateTypes": [
      "Message",
      "CallbackQuery",
      "MyChatMember"
    ]
  },
  "Telegram": {
    "Token": "",
    "WebhookUrl": "",
    "SecretToken": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "ZiggyCreatures.Caching.Fusion": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.ApplicationInsights"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "ApplicationInsights",
        "Args": {
          "connectionString": ""
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Musicality"
    }
  }
}
